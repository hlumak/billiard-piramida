{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed.ts",
    "test": "node --test --env-file-if-exists=../../.env test/*.test.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.4",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/websocket": "11.3.3",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "typebox": "1.3.36",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "7.0.2"
  }
}
