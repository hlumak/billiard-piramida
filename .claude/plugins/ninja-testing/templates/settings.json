{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Edit(**/__snapshots__/**)",
      "Read(**/docs/validation/**)",
      "Read(**/reports/agent-runs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ninja-testing/guard.mjs",
            "timeout": 10,
            "statusMessage": "ninja-testing guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ninja-testing/test-lint.mjs",
            "timeout": 15,
            "statusMessage": "ninja-testing test lint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ninja-testing/stop-check.mjs",
            "timeout": 20,
            "statusMessage": "ninja-testing stop check"
          }
        ]
      }
    ]
  }
}
