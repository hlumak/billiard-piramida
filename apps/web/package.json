{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate": "tsr generate && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie preferredLanguage baseLocale --silent",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=../../.env server.mjs",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "pnpm run generate && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-phone-number-input": "3.4.18",
    "srvx": "1.0.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.6",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.46",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
