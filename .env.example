# Copy to .env and adjust. One file serves both workflows in the README:
# local development (apps on the host) and the containerized stack (compose).

# --- Database ----------------------------------------------------------------
# Postgres credentials; docker-compose.yaml creates the database with these.
# The defaults suit local development only — set a real password for a deploy.
POSTGRES_USER=piramida
POSTGRES_PASSWORD=piramida
POSTGRES_DB=piramida
# How apps running on the host reach it (the containers build their own URL)
DATABASE_URL=postgres://piramida:piramida@localhost:5432/piramida

# --- API -----------------------------------------------------------------------
API_PORT=3001
# Loopback by default; the container image listens on 0.0.0.0 by itself
# API_HOST=127.0.0.1
LOG_LEVEL=info
# production: refuses placeholder or short secrets, CORS same-origin unless listed
# (the container image sets it)
# NODE_ENV=production
# Comma-separated CORS allowlist. Unset: same-origin only in production,
# http://localhost / 127.0.0.1 (any port) otherwise. Never "any origin".
# ALLOWED_ORIGINS=http://localhost:3000
# Shared secret for the /admin page; admin API is disabled when unset.
# At least 32 characters in production — generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me
# JWT signing secret for optional client accounts; auth is disabled when unset.
# At least 32 characters in production — generate with: openssl rand -hex 32
JWT_SECRET=change-me-long-random
# Proxies whose X-Forwarded-For the API trusts for the client IP (rate limiting):
# comma-separated IPs/CIDRs or @fastify/proxy-addr presets. Default trusts loopback
# and private ranges, i.e. nginx or the web server on this host or next to it.
# TRUSTED_PROXIES=loopback,uniquelocal
# Auth cookies are Secure by default (browsers accept that on http://localhost).
# Only for a plain-http host other than localhost:
# COOKIE_SECURE=false
# Staff-uploaded pictures (news cards) are written here and served under /api/uploads/.
# Defaults to apps/api/uploads (the container uses a volume at /data/uploads).
# UPLOADS_DIR=/var/lib/piramida/uploads
# Optional Meta Graph app token (App ID|App Secret or a long-lived app token) for
# instagram_oembed — makes "pull picture from Instagram post" reliable. Without it
# the importer falls back to reading the post page's og:image, which Instagram and
# Facebook serve to anonymous visitors only some of the time.
# META_OEMBED_TOKEN=

# --- Web -------------------------------------------------------------------------
# Where the browser calls the API. Leave unset: the browser then uses the page's
# own origin — the Vite dev server forwards /api to API_PORT, nginx does the same
# in the containers. Set it only when the API lives on another origin.
# VITE_API_URL=
# Absolute public URL of the site (canonical, og:image, JSON-LD, sitemap) — baked
# in at build time; the container build refuses to run without a real one
VITE_SITE_URL=http://localhost:3000
# How SSR reaches the API when it isn't on 127.0.0.1:$API_PORT (the compose
# stack sets http://api:3001)
# INTERNAL_API_URL=http://127.0.0.1:3001
# Staging: keep crawlers out (robots.txt answers "Disallow: /")
# ROBOTS_DISALLOW_ALL=1
